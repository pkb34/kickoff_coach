# Copy this file to secrets.toml and keep that copy off GitHub.
GEMINI_API_KEY = "your-key-here"
GEMINI_MODEL = "gemini-2.5-flash-lite"

# Optional: one synthetic Databricks record to personalize the Gaffer demo.
DATABRICKS_SERVER_HOSTNAME = "your-workspace.cloud.databricks.com"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/your-warehouse-id"
DATABRICKS_TOKEN = "your-private-token"
DATABRICKS_DEMO_STUDENT_ID = "VT-DEMO-001"
